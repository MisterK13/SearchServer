{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build main",
            "type": "shell",
            "command": "g++",
            "args": [
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Wshadow",
                "-Wformat=2",
                "-Wcast-align",
                "-Wconversion",
                "-Wsign-conversion",
                "-Wnull-dereference",
                "--std=c++20",
                "-g3",
                "-O0",
                "main.cpp",
                "document.cpp",
                "read_input_functions.cpp",
                "request_queue.cpp",
                "search_server.cpp",
                "string_processing.cpp",
                "-o",
                ".\\build\\Debug\\outDebug.exe"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build tests",
            "type": "shell",
            "command": "g++",
            "args": [
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Wshadow",
                "-Wformat=2",
                "-Wcast-align",
                "-Wconversion",
                "-Wsign-conversion",
                "-Wnull-dereference",
                "--std=c++20",
                "-g3",
                "-O0",
                "-pthread",
                "-fsanitize=thread",
                "test_multithread.cpp",
                "document.cpp",
                "read_input_functions.cpp",
                "request_queue.cpp",
                "search_server.cpp",
                "string_processing.cpp",
                "-o",
                ".\\build\\Debug\\tests.exe"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "build thread pool tests",
            "type": "shell",
            "command": "g++",
            "args": [
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Wshadow",
                "-Wformat=2",
                "-Wcast-align",
                "-Wconversion",
                "-Wsign-conversion",
                "-Wnull-dereference",
                "--std=c++20",
                "-g3",
                "-O2",
                "-pthread",
                "test_thread_pool.cpp",
                "async_search_server.cpp",
                "thread_pool.cpp",
                "search_server.cpp",
                "document.cpp",
                "read_input_functions.cpp",
                "request_queue.cpp",
                "string_processing.cpp",
                "-o",
                ".\\build\\Debug\\thread_pool_tests.exe"
            ],
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        }
    ]
}